# AMenu for the QMTECH Cyclone 10 LP core board (10CL025YU256I7G) + the I/O board on header U8.
# GENERATED by tools/mk_10cl025_qsf.py from ../ep4_ce15/AMenu.qsf: change that file (or the tool) and run the tool again.
# Sources, the .sdc and the ROM images are ../ep4_ce15's; this folder holds only the project and its outputs.

# AMenu -- machine menu (factory image), see rtl/AMenu.v and docs/PLAN.md
set_global_assignment -name FAMILY "Cyclone 10 LP"
set_global_assignment -name DEVICE 10CL025YU256I7G
set_global_assignment -name TOP_LEVEL_ENTITY AMenu
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED"
# remote update: this is the factory image; the machines are application images
set_global_assignment -name STRATIXIII_UPDATE_MODE REMOTE

set_global_assignment -name VERILOG_FILE ../ep4_ce15/rtl/AMenu.v
set_global_assignment -name VERILOG_FILE ../ep4_ce15/rtl/menu_boot.v
set_global_assignment -name VERILOG_FILE ../ep4_ce15/rtl/menu_video.v
set_global_assignment -name VERILOG_FILE ../ep4_ce15/rtl/menu_pll.v
set_global_assignment -name VERILOG_FILE ../../LSpectrum/ep4_ce15/rtl/tape_loader.v
set_global_assignment -name VERILOG_FILE ../../LSpectrum/ep4_ce15/rtl/esp_link.v
set_global_assignment -name VERILOG_FILE ../../LSpectrum/ep4_ce15/rtl/flash_if.v
set_global_assignment -name VERILOG_FILE ../../LSpectrum/ep4_ce15/rtl/zx_keyboard.v
set_global_assignment -name VERILOG_FILE ../../LSpectrum/ep4_ce15/rtl/vga_pll.v
set_global_assignment -name VERILOG_FILE ../../LSpectrum/ep4_ce15/rtl/vga_timing.v
set_global_assignment -name SDC_FILE ../ep4_ce15/AMenu.sdc

set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to VGA_*
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to KB_IN
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to KB_OUT

set_location_assignment PIN_E2 -to CLOCK_50
set_location_assignment PIN_F3 -to RESET_N
set_location_assignment PIN_N9 -to LEDR
set_location_assignment PIN_T14 -to KB_IN
set_location_assignment PIN_R14 -to AUDIO_AY
set_location_assignment PIN_T15 -to KB_OUT
set_location_assignment PIN_N12 -to AUDIO_BEEP
set_location_assignment PIN_P14 -to JOY1_UP_N
set_location_assignment PIN_N14 -to JOY1_DOWN_N
set_location_assignment PIN_P16 -to JOY1_FIRE_N
set_location_assignment PIN_N15 -to JOY2_UP_N
set_location_assignment PIN_N16 -to JOY2_DOWN_N
set_location_assignment PIN_L16 -to JOY2_FIRE_N
set_location_assignment PIN_D16 -to VGA_VS
set_location_assignment PIN_C14 -to VGA_HS
set_location_assignment PIN_C15 -to VGA_R[3]
set_location_assignment PIN_C16 -to VGA_R[1]
set_location_assignment PIN_A15 -to VGA_R[2]
set_location_assignment PIN_B16 -to VGA_R[0]
set_location_assignment PIN_A14 -to VGA_G[3]
set_location_assignment PIN_B14 -to VGA_G[1]
set_location_assignment PIN_A13 -to VGA_G[2]
set_location_assignment PIN_B13 -to VGA_G[0]
set_location_assignment PIN_A12 -to VGA_B[3]
set_location_assignment PIN_B12 -to VGA_B[1]
set_location_assignment PIN_A11 -to VGA_B[2]
set_location_assignment PIN_B11 -to VGA_B[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLOCK_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to RESET_N
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KB_IN
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KB_OUT
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to AUDIO_AY
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to AUDIO_BEEP
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to JOY1_UP_N
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to JOY1_DOWN_N
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to JOY1_FIRE_N
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to JOY2_UP_N
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to JOY2_DOWN_N
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to JOY2_FIRE_N
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to VGA_VS
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to VGA_HS
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to VGA_R[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to VGA_G[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to VGA_B[*]

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

# ESP32 SPI link (flash update, OSD): pins as in the machines; first synchroniser stages and the MISO
# register in the I/O cells (the pins have no SDC timing: asynchronous / false path)
set_location_assignment PIN_T11 -to ESP_SCK
set_location_assignment PIN_R11 -to ESP_MOSI
set_location_assignment PIN_T12 -to ESP_CS_N
set_location_assignment PIN_R12 -to ESP_MISO
set_location_assignment PIN_P9 -to ESP_IRQ
set_location_assignment PIN_T13 -to BT_TX
set_location_assignment PIN_R13 -to BT_RX
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ESP_SCK
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ESP_MOSI
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ESP_CS_N
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ESP_MISO
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ESP_IRQ
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to BT_TX
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to BT_RX
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to BT_RX
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to ESP_SCK
set_instance_assignment -name FAST_INPUT_REGISTER ON -to ESP_SCK
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to ESP_MOSI
set_instance_assignment -name FAST_INPUT_REGISTER ON -to ESP_MOSI
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to ESP_CS_N
set_instance_assignment -name FAST_INPUT_REGISTER ON -to ESP_CS_N
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to ESP_MISO
# flash_if.v: the Cyclone 10 LP variant of the active-serial block
set_global_assignment -name VERILOG_MACRO "CYCLONE10LP=1"
set_parameter -name FONT_HEX "../ep4_ce15/rtl/menu_font.hex"
set_parameter -name TEXT_HEX "../ep4_ce15/rtl/menu_text.hex"

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top